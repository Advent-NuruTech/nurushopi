// NuruShop — Prisma schema (full domain)
// Provider: PostgreSQL (Supabase now; portable to AWS RDS / any Postgres by swapping env URLs).
// Money is stored as Decimal(12,2). Ids are cuid() strings.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// Enums
// ============================================================

enum AdminRole {
  SENIOR
  SUB
}

enum AdminInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum FulfillmentMethod {
  LEGACY
  PICKUP_STATION
  DOORSTEP
}

enum DeliveryFeeStatus {
  CONFIRMED
  PENDING_QUOTE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WishlistStatus {
  ACTIVE
  PURCHASED
  REMOVED
}

enum WalletTxType {
  CREDIT
  DEBIT
}

enum WalletTxSource {
  AFFILIATE
  REDEEM
  ADJUSTMENT
  REFUND
}

enum WalletTxStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RedemptionStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum NotificationRecipientType {
  USER
  ADMIN
}

enum MessageSenderType {
  USER
  ADMIN
}

enum VendorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MerchandisingStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MembershipSource {
  AUTOMATIC
  MANUAL
  ALGORITHM
  PROMOTION
  RECOMMENDATION
  SPONSORED
}

enum CollectionOverrideType {
  PIN
  EXCLUDE
  BOOST
  LOWER
}

enum PromotionDiscountType {
  FIXED_PRICE
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromotionFundingType {
  SELLER
  PLATFORM
  SHARED
}

enum BundleDiscountType {
  FIXED_PRICE
  PERCENTAGE
  FIXED_AMOUNT
}

enum RetentionTriggerStatus {
  PENDING
  CLAIMED
  SENT
  SKIPPED
  FAILED
}

enum ExperimentStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
}

// ============================================================
// Identity & Auth
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String? // null for OAuth-only accounts
  name          String?
  phone         String?
  address       String?
  avatarUrl     String?
  emailVerified DateTime?
  isActive      Boolean   @default(true)

  // Wallet / referral program
  walletBalance Decimal @default(0) @db.Decimal(12, 2)
  referralCode  String? @unique
  referredById  String?
  referredBy    User?   @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals     User[]  @relation("UserReferrals")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  oauthAccounts           OAuthAccount[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  legacyPassword          LegacyPasswordImport?
  orders                  Order[]
  reviews                 Review[]
  productViews            ProductView[]
  walletTransactions      WalletTransaction[]
  walletRedemptions       WalletRedemption[]
  sentMessages            Message[]                @relation("UserMessages")
  vendorApplications      VendorApplication[]
  referralEvents          Referral[]               @relation("ReferralReferrer")
  referredEvents          Referral[]               @relation("ReferralReferred")
  commerceEvents          CommerceEvent[]
  productAffinities       UserProductAffinity[]
  notificationPreferences NotificationPreference[]
  retentionTriggers       RetentionTrigger[]
  experimentAssignments   ExperimentAssignment[]
  promotionRedemptions    PromotionRedemption[]
  retentionSubscriptions  RetentionSubscription[]
  wishlistItems           WishlistItem[]

  @@index([referredById])
  @@map("users")
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google"
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// Refresh tokens are stored hashed. `familyId` ties a rotation chain together
// so that reuse of a revoked token can revoke the whole family.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Imported Firebase Auth scrypt password hashes, kept ONLY to let migrated
// users keep their existing password through one transparent login. On the
// first successful legacy verification the password is re-hashed to bcrypt
// (stored on `users.passwordHash`) and the matching row here is deleted —
// so this table naturally drains to empty as users return. Never written by
// the normal app; populated by the migration tool, consumed by login.
model LegacyPasswordImport {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash      String // Firebase passwordHash (base64)
  salt      String // Firebase passwordSalt (base64)
  createdAt DateTime @default(now())

  @@map("legacy_password_imports")
}

// Brute-force lockout tracking, keyed by the login identifier (email).
model LoginAttempt {
  id            String    @id @default(cuid())
  identifier    String    @unique // lowercased email
  failedCount   Int       @default(0)
  lockedUntil   DateTime?
  lastAttemptAt DateTime  @default(now())

  @@map("login_attempts")
}

// ============================================================
// Admin
// ============================================================

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(SUB)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  logs                     AdminLog[]
  createdProducts          Product[]                 @relation("ProductCreatedBy")
  invitesSent              AdminInvite[]             @relation("InviteCreatedBy")
  merchandisingCollections MerchandisingCollection[] @relation("CollectionCreatedBy")
  collectionOverrides      CollectionOverride[]      @relation("OverrideCreatedBy")
  promotions               Promotion[]               @relation("PromotionCreatedBy")
  bundles                  Bundle[]                  @relation("BundleCreatedBy")
  spotlightPlacements      SpotlightPlacement[]      @relation("SpotlightCreatedBy")

  @@map("admins")
}

model AdminInvite {
  id          String            @id @default(cuid())
  email       String
  role        AdminRole         @default(SUB)
  tokenHash   String            @unique
  status      AdminInviteStatus @default(PENDING)
  createdById String?
  createdBy   Admin?            @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime          @default(now())

  @@index([email])
  @@map("admin_invites")
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([entity, entityId])
  @@map("admin_logs")
}

// ============================================================
// Catalog
// ============================================================

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  icon        String?
  imageUrl    String?
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products       Product[]
  wholesaleItems WholesaleItem[]

  @@map("categories")
}

model Product {
  id                String   @id @default(cuid())
  name              String
  slug              String?  @unique
  sku               String?  @unique
  brandName         String?
  storeName         String?
  description       String?
  shortDescription  String?
  price             Decimal  @db.Decimal(12, 2)
  originalPrice     Decimal? @db.Decimal(12, 2)
  sellingPrice      Decimal? @db.Decimal(12, 2)
  images            String[] // Cloudinary URLs (up to 3)
  variants          Json     @default("[]")
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  isActive          Boolean  @default(true)
  isFeatured        Boolean  @default(false)

  // Approved-review projection. The review module refreshes these fields in
  // the same transaction as moderation so catalog cards never need N+1 queries.
  ratingAverage      Decimal @default(0) @db.Decimal(3, 2)
  ratingCount        Int     @default(0)
  ratingDistribution Json?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   Admin?  @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  vendorId String?
  vendor   VendorAccount? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems             OrderItem[]
  reviews                Review[]
  views                  ProductView[]
  collectionMemberships  CollectionMembership[]
  collectionOverrides    CollectionOverride[]
  promotionProducts      PromotionProduct[]
  bundleItems            BundleItem[]
  commerceEvents         CommerceEvent[]
  hourlyMetrics          ProductMetricHourly[]
  dailyMetrics           ProductMetricDaily[]
  rankings               ProductRanking[]
  userAffinities         UserProductAffinity[]
  retentionTriggers      RetentionTrigger[]
  promotionRedemptions   PromotionRedemption[]
  retentionSubscriptions RetentionSubscription[]
  wishlistItems          WishlistItem[]

  @@index([categoryId])
  @@index([createdById])
  @@index([vendorId])
  @@map("products")
}

model Banner {
  id        String   @id @default(cuid())
  title     String?
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

model HeroAnnouncement {
  id           String    @id @default(cuid())
  message      String
  linkUrl      String?
  /**
   * Optional CSS gradient token rendered behind the marquee slide.
   */
  gradient     String?
  /**
   * Sort position in the marquee; lower shows first.
   */
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive, displayOrder])
  @@map("hero_announcements")
}

model WholesaleItem {
  id          String         @id @default(cuid())
  name        String
  slug        String?        @unique
  sku         String?        @unique
  description String?
  unitPrice   Decimal        @db.Decimal(12, 2)
  minQuantity Int            @default(1)
  stock       Int            @default(0)
  images      String[]
  variants    Json           @default("[]")
  isActive    Boolean        @default(true)
  categoryId  String?
  category    Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vendorId    String?
  vendor      VendorAccount? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([categoryId])
  @@index([vendorId])
  @@map("wholesale_items")
}

// ============================================================
// Commerce
// ============================================================

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique @default(cuid())
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  subtotal      Decimal @db.Decimal(12, 2)
  walletApplied Decimal @default(0) @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)

  // Snapshot of contact / delivery details
  contactName  String?
  contactPhone String?
  contactEmail String?
  address      String?
  note         String?

  // Immutable fulfillment snapshot. LEGACY keeps pre-feature orders and the
  // existing checkout path valid when the fulfillment feature is disabled.
  fulfillmentMethod    FulfillmentMethod @default(LEGACY)
  pickupStationId      String?
  pickupStation        PickupStation?    @relation(fields: [pickupStationId], references: [id], onDelete: SetNull)
  pickupStationName    String?
  pickupStationAddress String?
  deliveryFee          Decimal           @default(0) @db.Decimal(12, 2)
  deliveryFeeStatus    DeliveryFeeStatus @default(CONFIRMED)
  deliveryEta          String?
  deliveryOrigin       String?
  deliveryRateId       String?
  deliveryRate         DeliveryRate?     @relation(fields: [deliveryRateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items                OrderItem[]
  promotionRedemptions PromotionRedemption[]

  @@index([userId])
  @@index([status])
  @@index([pickupStationId])
  @@index([deliveryRateId])
  @@map("orders")
}

// A singleton row (id = "default") controls the optional fulfillment flow.
// The absence of this row is intentionally equivalent to feature-disabled.
model FulfillmentConfiguration {
  id                            String   @id @default("default")
  featureEnabled                Boolean  @default(false)
  pickupEnabled                 Boolean  @default(true)
  doorstepEnabled               Boolean  @default(true)
  doorstepFee                   Decimal  @default(0) @db.Decimal(12, 2)
  doorstepEstimatedDeliveryTime String?
  dispatchCounty                String?
  dispatchArea                  String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@map("fulfillment_configurations")
}

model PickupStation {
  id                    String    @id @default(cuid())
  name                  String
  address               String
  city                  String?
  region                String?
  latitude              Decimal?  @db.Decimal(10, 7)
  longitude             Decimal?  @db.Decimal(10, 7)
  contactPhone          String?
  operatingHours        String?
  deliveryFee           Decimal   @default(0) @db.Decimal(12, 2)
  estimatedDeliveryTime String?
  instructions          String?
  isActive              Boolean   @default(true)
  archivedAt            DateTime?
  displayOrder          Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  orders Order[]

  @@index([isActive, archivedAt, displayOrder])
  @@index([city])
  @@index([region])
  @@map("pickup_stations")
}

model DeliveryRate {
  id                    String            @id @default(cuid())
  name                  String
  method                FulfillmentMethod
  originCounty          String
  originArea            String?
  destinationCounty     String
  destinationArea       String?
  fee                   Decimal           @db.Decimal(12, 2)
  estimatedDeliveryTime String
  priority              Int               @default(0)
  isActive              Boolean           @default(true)
  archivedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  orders Order[]

  @@index([method, isActive, archivedAt, priority])
  @@index([originCounty, destinationCounty])
  @@map("delivery_rates")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Snapshot fields so history survives product edits/deletes
  productName String
  unitPrice   Decimal  @db.Decimal(12, 2)
  quantity    Int
  imageUrl    String?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Review {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int // 1..5
  comment   String?
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([productId, status])
  @@index([userId])
  @@map("reviews")
}

/// Durable purchase intent. Rows are retained when removed or purchased so
/// customer intent and reminder outcomes remain measurable without resurrecting
/// old reminders. reminderVersion invalidates stale outbox entries after edits.
model WishlistItem {
  id                     String         @id @default(cuid())
  userId                 String
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId              String
  product                Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  status                 WishlistStatus @default(ACTIVE)
  plannedPurchaseAt      DateTime?
  remindersEnabled       Boolean        @default(false)
  reminderTimezone       String?
  reminderVersion        Int            @default(1)
  preReminderSentAt      DateTime?
  followupReminderSentAt DateTime?
  purchasedAt            DateTime?
  removedAt              DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@unique([userId, productId])
  @@index([userId, status, updatedAt])
  @@index([productId, status])
  @@index([status, plannedPurchaseAt])
  @@map("wishlist_items")
}

model ProductView {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@map("product_views")
}

// ============================================================
// Wallet / referral
// ============================================================

model WalletTransaction {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         WalletTxType
  source       WalletTxSource
  amount       Decimal        @db.Decimal(12, 2)
  balanceAfter Decimal        @db.Decimal(12, 2)
  status       WalletTxStatus @default(APPROVED)
  orderId      String?
  redemptionId String?
  metadata     Json?
  createdAt    DateTime       @default(now())

  @@index([userId])
  @@map("wallet_transactions")
}

model WalletRedemption {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Decimal          @db.Decimal(12, 2)
  status    RedemptionStatus @default(PENDING)
  method    String? // e.g. "mpesa", "bank"
  details   Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@map("wallet_redemptions")
}

model Referral {
  id           String   @id @default(cuid())
  referrerId   String
  referrer     User     @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId   String
  referred     User     @relation("ReferralReferred", fields: [referredId], references: [id], onDelete: Cascade)
  rewardAmount Decimal  @default(0) @db.Decimal(12, 2)
  rewarded     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([referredId]) // a user can only be referred once
  @@index([referrerId])
  @@map("referrals")
}

// ============================================================
// Engagement
// ============================================================

model Notification {
  id            String                    @id @default(cuid())
  recipientType NotificationRecipientType
  recipientId   String? // userId or adminId; null = broadcast
  title         String
  body          String?
  type          String? // "order", "security", "system", ...
  relatedId     String?
  read          Boolean                   @default(false)
  createdAt     DateTime                  @default(now())

  @@index([recipientType, recipientId, read])
  @@map("notifications")
}

model Message {
  id            String            @id @default(cuid())
  threadId      String
  senderType    MessageSenderType
  senderUserId  String?
  senderUser    User?             @relation("UserMessages", fields: [senderUserId], references: [id], onDelete: SetNull)
  senderAdminId String?
  body          String
  attachments   String[]
  read          Boolean           @default(false)
  createdAt     DateTime          @default(now())

  @@index([threadId, createdAt])
  @@index([senderUserId])
  @@map("messages")
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  subject   String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contacts")
}

model VendorApplication {
  id           String                  @id @default(cuid())
  userId       String?
  user         User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  businessName String
  contactName  String?
  email        String
  phone        String?
  description  String?
  status       VendorApplicationStatus @default(PENDING)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  account       VendorAccount?
  vendorInvites VendorInvite[]

  @@index([userId])
  @@index([status])
  @@map("vendor_applications")
}

model VendorAccount {
  id            String            @id @default(cuid())
  email         String            @unique
  passwordHash  String
  name          String
  applicationId String            @unique
  application   VendorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  products       Product[]
  wholesaleItems WholesaleItem[]

  @@map("vendor_accounts")
}

model VendorInvite {
  id            String            @id @default(cuid())
  email         String
  applicationId String
  application   VendorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tokenHash     String            @unique
  status        AdminInviteStatus @default(PENDING)
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime          @default(now())

  @@index([email])
  @@map("vendor_invites")
}

model PwaInstall {
  id        String   @id @default(cuid())
  userId    String?
  platform  String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("pwa_installs")
}

model SabbathMessage {
  id          String   @id @default(cuid())
  message     String
  // The Friday (YYYY-MM-DD) this devotional message is scheduled for. Validated
  // app-side to fall on a Friday. Not unique: the latest by createdAt wins.
  sabbathDate String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sabbathDate, createdAt])
  @@map("sabbath_messages")
}

// ============================================================
// Merchandising, promotions, discovery, retention & experiments
// ============================================================

/// Stable merchandising identity. `key` is deliberately not exposed by any
/// update input; presentation, rules and scheduling may change independently.
model MerchandisingCollection {
  id                String              @id @default(cuid())
  key               String              @unique
  displayName       String
  shortName         String?
  description       String?
  collectionType    String              @default("generic")
  selectionStrategy String              @default("hybrid")
  status            MerchandisingStatus @default(DRAFT)
  priority          Int                 @default(0)
  placement         String?
  startAt           DateTime?
  endAt             DateTime?
  maxProducts       Int                 @default(24)
  sortStrategy      String              @default("rank")
  eligibilityRules  Json?
  configuration     Json?
  imageUrl          String?
  icon              String?
  badgeText         String?
  ctaText           String?
  ctaUrl            String?
  isPersonalized    Boolean             @default(false)
  isSponsored       Boolean             @default(false)
  cacheVersion      Int                 @default(1)
  createdById       String?
  createdBy         Admin?              @relation("CollectionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  memberships      CollectionMembership[]
  overrides        CollectionOverride[]
  homepageSections HomepageSection[]
  rankings         ProductRanking[]
  commerceEvents   CommerceEvent[]
  dailyMetrics     CollectionMetricDaily[]
  promotions       Promotion[]

  @@index([status, startAt, endAt])
  @@index([priority, id])
  @@map("merchandising_collections")
}

model CollectionMembership {
  id           String                  @id @default(cuid())
  collectionId String
  collection   MerchandisingCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  source       MembershipSource        @default(AUTOMATIC)
  score        Float                   @default(0)
  rank         Int?
  startsAt     DateTime?
  expiresAt    DateTime?
  metadata     Json?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@unique([collectionId, productId])
  @@index([collectionId, rank, productId])
  @@index([collectionId, score, productId])
  @@index([productId])
  @@index([expiresAt])
  @@map("collection_memberships")
}

model CollectionOverride {
  id           String                  @id @default(cuid())
  collectionId String
  collection   MerchandisingCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  type         CollectionOverrideType
  value        Float                   @default(0)
  reason       String?
  startsAt     DateTime?
  expiresAt    DateTime?
  createdById  String?
  createdBy    Admin?                  @relation("OverrideCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime                @default(now())

  @@index([collectionId, type, startsAt, expiresAt])
  @@index([productId])
  @@map("collection_overrides")
}

model HomepageSection {
  id            String                  @id @default(cuid())
  collectionId  String
  collection    MerchandisingCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  position      Int
  status        MerchandisingStatus     @default(DRAFT)
  audience      Json?
  device        String                  @default("all")
  startAt       DateTime?
  endAt         DateTime?
  configuration Json?
  experimentKey String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([status, device, position])
  @@index([startAt, endAt])
  @@map("homepage_sections")
}

model Promotion {
  id               String                   @id @default(cuid())
  key              String                   @unique
  name             String
  status           MerchandisingStatus      @default(DRAFT)
  discountType     PromotionDiscountType
  discountValue    Decimal                  @db.Decimal(12, 2)
  fundingType      PromotionFundingType     @default(PLATFORM)
  sellerFundingPct Decimal?                 @db.Decimal(5, 2)
  collectionId     String?
  collection       MerchandisingCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  startsAt         DateTime
  endsAt           DateTime
  inventoryLimit   Int?
  purchasedCount   Int                      @default(0)
  perCustomerLimit Int?
  configuration    Json?
  createdById      String?
  createdBy        Admin?                   @relation("PromotionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  products    PromotionProduct[]
  redemptions PromotionRedemption[]

  @@index([status, startsAt, endsAt])
  @@index([collectionId])
  @@map("promotions")
}

model PromotionProduct {
  id               String    @id @default(cuid())
  promotionId      String
  promotion        Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  promotionalPrice Decimal?  @db.Decimal(12, 2)
  inventoryLimit   Int?
  purchasedCount   Int       @default(0)
  perCustomerLimit Int?
  metadata         Json?
  createdAt        DateTime  @default(now())

  redemptions PromotionRedemption[]

  @@unique([promotionId, productId])
  @@index([productId, promotionId])
  @@map("promotion_products")
}

model PromotionRedemption {
  id                 String           @id @default(cuid())
  promotionId        String
  promotion          Promotion        @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  promotionProductId String
  promotionProduct   PromotionProduct @relation(fields: [promotionProductId], references: [id], onDelete: Restrict)
  productId          String
  product            Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderId            String
  order              Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  userId             String?
  user               User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  anonymousId        String?
  quantity           Int
  unitDiscount       Decimal          @db.Decimal(12, 2)
  createdAt          DateTime         @default(now())

  @@index([promotionId, userId])
  @@index([promotionId, anonymousId])
  @@index([orderId])
  @@map("promotion_redemptions")
}

model Bundle {
  id               String              @id @default(cuid())
  key              String              @unique
  displayName      String
  description      String?
  status           MerchandisingStatus @default(DRAFT)
  discountType     BundleDiscountType
  discountValue    Decimal             @db.Decimal(12, 2)
  startsAt         DateTime?
  endsAt           DateTime?
  maxPurchases     Int?
  purchasedCount   Int                 @default(0)
  allowCrossSeller Boolean             @default(false)
  configuration    Json?
  createdById      String?
  createdBy        Admin?              @relation("BundleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  items BundleItem[]

  @@index([status, startsAt, endsAt])
  @@map("bundles")
}

model BundleItem {
  id        String  @id @default(cuid())
  bundleId  String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int     @default(1)
  required  Boolean @default(true)
  sortOrder Int     @default(0)
  metadata  Json?

  @@unique([bundleId, productId])
  @@index([productId])
  @@map("bundle_items")
}

model SpotlightPlacement {
  id          String   @id @default(cuid())
  targetType  String
  targetId    String
  placement   String
  priority    Int      @default(0)
  audience    Json?
  region      String?
  reason      String?
  creative    Json?
  ctaText     String?
  ctaUrl      String?
  startsAt    DateTime
  endsAt      DateTime
  createdById String?
  createdBy   Admin?   @relation("SpotlightCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([placement, startsAt, endsAt, priority])
  @@index([targetType, targetId])
  @@map("spotlight_placements")
}

/// Append-only ingestion table. At high volume this table is range-partitioned
/// by `occurredAt`; the Prisma model stays portable for today's deployment.
model CommerceEvent {
  id               String                   @id @default(cuid())
  eventId          String                   @unique
  eventType        String
  userId           String?
  user             User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  anonymousId      String?
  sessionId        String?
  productId        String?
  product          Product?                 @relation(fields: [productId], references: [id], onDelete: SetNull)
  sellerId         String?
  collectionId     String?
  collection       MerchandisingCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  searchQueryId    String?
  recommendationId String?
  experimentKey    String?
  variantKey       String?
  position         Int?
  source           String?
  device           String?
  ipHash           String?
  userAgentHash    String?
  trusted          Boolean                  @default(true)
  abuseScore       Float                    @default(0)
  occurredAt       DateTime
  receivedAt       DateTime                 @default(now())
  metadata         Json?

  @@index([eventType, occurredAt])
  @@index([productId, eventType, occurredAt])
  @@index([collectionId, eventType, occurredAt])
  @@index([userId, occurredAt])
  @@index([sessionId, occurredAt])
  @@map("commerce_events")
}

model ProductMetricHourly {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  bucketStart      DateTime
  impressions      Int      @default(0)
  uniqueViewers    Int      @default(0)
  views            Int      @default(0)
  wishlistAdds     Int      @default(0)
  cartAdds         Int      @default(0)
  purchases        Int      @default(0)
  unitsSold        Int      @default(0)
  revenue          Decimal  @default(0) @db.Decimal(14, 2)
  cancellations    Int      @default(0)
  returns          Int      @default(0)
  reviewActivity   Int      @default(0)
  suspiciousEvents Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@unique([productId, bucketStart])
  @@index([bucketStart, productId])
  @@map("product_metrics_hourly")
}

model ProductMetricDaily {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  bucketDate     DateTime @db.Date
  impressions    Int      @default(0)
  uniqueViewers  Int      @default(0)
  views          Int      @default(0)
  wishlistAdds   Int      @default(0)
  cartAdds       Int      @default(0)
  purchases      Int      @default(0)
  unitsSold      Int      @default(0)
  revenue        Decimal  @default(0) @db.Decimal(14, 2)
  cancellations  Int      @default(0)
  returns        Int      @default(0)
  reviewActivity Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([productId, bucketDate])
  @@index([bucketDate, productId])
  @@map("product_metrics_daily")
}

model CollectionMetricDaily {
  id            String                  @id @default(cuid())
  collectionId  String
  collection    MerchandisingCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  bucketDate    DateTime                @db.Date
  impressions   Int                     @default(0)
  uniqueViewers Int                     @default(0)
  clicks        Int                     @default(0)
  productViews  Int                     @default(0)
  cartAdds      Int                     @default(0)
  purchases     Int                     @default(0)
  orders        Int                     @default(0)
  revenue       Decimal                 @default(0) @db.Decimal(14, 2)
  updatedAt     DateTime                @updatedAt

  @@unique([collectionId, bucketDate])
  @@index([bucketDate, collectionId])
  @@map("collection_metrics_daily")
}

model ProductRanking {
  id           String                  @id @default(cuid())
  collectionId String
  collection   MerchandisingCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  algorithm    String
  segmentKey   String                  @default("global")
  snapshotAt   DateTime
  score        Float
  rank         Int
  reasons      Json?
  expiresAt    DateTime?
  createdAt    DateTime                @default(now())

  @@unique([collectionId, algorithm, segmentKey, snapshotAt, productId])
  @@index([collectionId, segmentKey, snapshotAt, rank, productId])
  @@index([expiresAt])
  @@map("product_rankings")
}

model UserProductAffinity {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  score      Float
  reasons    Json?
  computedAt DateTime
  expiresAt  DateTime?

  @@unique([userId, productId])
  @@index([userId, score, productId])
  @@map("user_product_affinities")
}

model NotificationPreference {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel     String
  topic       String
  enabled     Boolean   @default(false)
  consentedAt DateTime?
  quietHours  Json?
  maxPerDay   Int       @default(2)
  maxPerWeek  Int       @default(5)
  updatedAt   DateTime  @updatedAt

  @@unique([userId, channel, topic])
  @@index([userId, enabled])
  @@map("notification_preferences")
}

model RetentionSubscription {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  subscriptionType String
  active           Boolean   @default(true)
  lastNotifiedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, productId, subscriptionType])
  @@index([productId, subscriptionType, active])
  @@map("retention_subscriptions")
}

/// Durable outbox for useful, consent-aware retention messaging.
model RetentionTrigger {
  id               String                 @id @default(cuid())
  deduplicationKey String                 @unique
  userId           String
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  triggerType      String
  channel          String
  status           RetentionTriggerStatus @default(PENDING)
  priority         Int                    @default(0)
  scheduledAt      DateTime
  claimedAt        DateTime?
  sentAt           DateTime?
  expiresAt        DateTime?
  attemptCount     Int                    @default(0)
  payload          Json?
  lastError        String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([status, scheduledAt, priority])
  @@index([userId, triggerType, createdAt])
  @@map("retention_triggers")
}

model Experiment {
  id               String           @id @default(cuid())
  key              String           @unique
  name             String
  status           ExperimentStatus @default(DRAFT)
  variants         Json
  allocation       Int              @default(10000)
  primaryMetric    String
  guardrailMetrics Json?
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  assignments ExperimentAssignment[]

  @@index([status, startsAt, endsAt])
  @@map("experiments")
}

model ExperimentAssignment {
  id           String     @id @default(cuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousId  String?
  variantKey   String
  bucket       Int
  assignedAt   DateTime   @default(now())

  @@unique([experimentId, userId])
  @@unique([experimentId, anonymousId])
  @@index([experimentId, variantKey])
  @@map("experiment_assignments")
}
